# ===========================================================================
# SIPARTA Backend — Environment Variables
# ===========================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Supabase ---
SUPABASE_URL=https://qttpjrgcatioxrfccnmt.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Google Gemini AI ---
GEMINI_API_KEY=

# --- Blockchain (Merujuk ke blockchain_services/.env) ---
# Backend tidak memegang private key secara langsung.
# Komunikasi ke blockchain melalui subprocess ke relay.ts.
# Perhatikan bahwa variabel seperti PINATA_JWT dan RELAYER_PRIVATE_KEY
# harus didefinisikan di environment karena akan diwariskan ke subprocess Node.js.

# --- IoT Device Authentication ---
# Kunci autentikasi untuk Raspberry Pi saat mengirim laporan insiden.
# Harus sama dengan header X-API-Key yang dikirim oleh main_rpi.py.
# Kosongkan untuk melewati autentikasi (mode development).
DEVICE_API_KEY=

# --- Cloudinary (Opsional — Fallback Image Upload) ---
# Digunakan jika Supabase Storage belum dikonfigurasi untuk penyimpanan gambar.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Debug ---
DEBUG=false